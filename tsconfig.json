{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 tar ikke med globale typer av seg selv. Jest trengs for testene.
    "types": ["jest"]
  },
  // Edge Functions er Deno-kode og typesjekkes ikke sammen med appen.
  // Listen erstatter Expos standard, så standardoppføringene må gjentas.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "supabase/functions"
  ]
}

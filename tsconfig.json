{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // Edge Functions er Deno-kode og typesjekkes ikke sammen med appen.
  // Listen erstatter Expos standard, så standardoppføringene må gjentas.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "supabase/functions"
  ]
}
